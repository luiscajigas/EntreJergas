{
  "name": "entrejergas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:start\"",
    "install:api": "npm --prefix ../EntreJergas-Back/backend install",
    "dev:api": "npm --prefix ../EntreJergas-Back/backend run dev",
    "dev:web": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:api": "npm --prefix ../EntreJergas-Back/backend start"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.150.0"
  }
}